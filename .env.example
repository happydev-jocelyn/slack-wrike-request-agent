# 복사해서 .env로 저장한 뒤 값을 채웁니다. .env는 git에 올리지 않습니다.
# 서버에 넣는 값은 아래 네 개뿐이고, 나머지 설정은 Slack 앱 홈 탭에서 관리자가 입력합니다.

# Slack 앱 토큰 (docs/install.md 2단계)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 홈 탭 설정을 열 수 있는 관리자 Slack 사용자 ID(쉼표 구분)
ADMIN_IDS=U01234567
# 설정에 저장하는 토큰·키를 암호화하는 키 (docs/install.md 3단계에서 만듭니다).
# 잃어버리면 홈 탭 설정을 다시 입력해야 합니다.
SETTINGS_KEY=

# 승인·반려 이모지 (선택)
APPROVE_EMOJI=white_check_mark
REJECT_EMOJI=x

# ---- 선택: 홈 탭 대신 환경변수로 설정하는 방식 ----
# 홈 탭에 저장한 설정이 있으면 그쪽이 우선합니다.
# REQUEST_CHANNEL_ID=C01234567
# APPROVER_IDS=U01234567,U07654321
# CATEGORIES=feature:기능,bug:버그,improvement:개선,etc:기타
# WRIKE_BASE_URL=https://www.wrike.com/api/v4
# WRIKE_TOKEN=
# WRIKE_REQUEST_FOLDER_ID=
# WRIKE_WORK_FOLDER_ID=
# WRIKE_TICKET_TYPE_ID=
# WRIKE_STATUS_REVIEWING=
# WRIKE_STATUS_CONFIRMED=
# WRIKE_STATUS_REJECTED=
# AI_OPINION=on
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
