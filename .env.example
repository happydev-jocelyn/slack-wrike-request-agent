# 복사해서 .env로 저장한 뒤 값을 채웁니다. .env는 git에 올리지 않습니다.

# Slack 앱 토큰 (docs/install.md 2단계)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# 요청 채널 이름(# 빼고)과 승인자 Slack 사용자 ID(쉼표 구분)
REQUEST_CHANNEL=requests
APPROVER_IDS=U01234567,U07654321
# Enterprise 조직 단위로 설치했을 때만: 채널이 있는 워크스페이스 ID(T로 시작)
TEAM_ID=

# 이모지와 카테고리("값:표시이름"을 쉼표로 구분)
APPROVE_EMOJI=white_check_mark
REJECT_EMOJI=x
CATEGORIES=feature:기능,bug:버그,improvement:개선,etc:기타

# Wrike (docs/install.md 3단계). 지역 계정이면 https://app-eu.wrike.com/api/v4 등
WRIKE_BASE_URL=https://www.wrike.com/api/v4
WRIKE_TOKEN=
WRIKE_REQUEST_FOLDER_ID=
WRIKE_WORK_FOLDER_ID=
# 사용자 정의 항목 유형(티켓)을 쓸 때만. 비우면 일반 일감으로 만듭니다.
WRIKE_TICKET_TYPE_ID=
# 전용 요청 워크플로의 상태 ID 3개
WRIKE_STATUS_REVIEWING=
WRIKE_STATUS_CONFIRMED=
WRIKE_STATUS_REJECTED=
